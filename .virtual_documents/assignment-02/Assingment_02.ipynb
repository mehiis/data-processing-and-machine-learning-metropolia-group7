











from ucimlrepo import fetch_ucirepo
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


bcwd = fetch_ucirepo(id=17)

#X -> y
X = bcwd.data.features #all the features of the data
y = bcwd.data.targets #predicted values

X.describe(include='all')





